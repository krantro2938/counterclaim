# ── Database ───────────────────────────────────────────────
DATABASE_URL=postgres://counterclaim:counterclaim@localhost:5433/counterclaim

# ── PayPal sandbox (Developer Dashboard → Apps & Credentials → Sandbox) ──
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
# Webhook ID of the webhook registered for https://<host>/webhooks/paypal
PAYPAL_WEBHOOK_ID=

# ── LLM provider: openai_compat (Inception Mercury) | anthropic ──
AI_PROVIDER=openai_compat
OPENAI_URL=https://api.inceptionlabs.ai/v1
OPENAI_KEY=
OPENAI_MODEL=mercury-3
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_ASSESS=claude-sonnet-5-5
ANTHROPIC_MODEL_CHEAP=claude-haiku-5-5
# auto | tools | single_shot   (auto = tools for anthropic, tools-with-fallback for openai_compat)
AGENT_MODE=auto

# ── App ────────────────────────────────────────────────────
PUBLIC_BASE_URL=http://localhost:3000
# separate = run `pnpm worker` as its own process; inprocess = worker loop inside the web server
WORKER_MODE=separate
LAB_ENABLED=true
# Reset wipes the shared demo for everyone: keep false on a public deployment
LAB_RESET_ENABLED=false
LOG_LEVEL=info

# ── Video tooling only ─────────────────────────────────────
MISTRAL_API_KEY=
